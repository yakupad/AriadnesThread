# .NET build artifacts (src/AriadnesThread.Core, src/AriadnesThread.Core.Tests)
bin/
obj/

# Unity (added once the Unity project lands in this repo — Unity auto-generates its own
# per-assembly .csproj/.sln at that point; those should be ignored too, but the ones
# under src/ above are hand-written for the standalone dotnet build and must stay tracked)
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/
.vs/
.vscode/
*.DS_Store
._*

# Unity regenerates these IDE project files at the repo root on every open/compile —
# root-only patterns (leading slash, no further slash) so the hand-written ones under
# src/ stay tracked.
/*.csproj
/*.slnx

# Source clone used to build the Apple.GameKit/.Core .tgz packages checked into
# LocalPackages/ — the clone itself isn't needed once those are built.
/vendor/
